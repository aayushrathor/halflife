{
  "compilerOptions": {
    "target": "es2021",
    "module": "preserve",
    "lib": ["es2021", "dom"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["js/*.js", "js/*.d.ts"]
}
